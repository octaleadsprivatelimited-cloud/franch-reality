# Franch Realty platform - local environment template
# Copy this file to .env. Never commit a real .env file.

# PostgreSQL (the local Docker service is exposed on port 5433)
DATABASE_URL="postgresql://franch:franch_dev_pw@localhost:5433/franch_realty?schema=public"

# Auth.js
# Generate a production value with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-auth-secret"
AUTH_URL="http://localhost:3100"

# Object storage: "s3" for MinIO/R2 or "azure" for Azure Blob Storage
STORAGE_PROVIDER="s3"

# S3-compatible storage (local values match docker-compose.yml)
S3_ENDPOINT="http://localhost:9100"
S3_REGION="auto"
S3_ACCESS_KEY_ID="franch_minio"
S3_SECRET_ACCESS_KEY="franch_minio_dev_pw"
S3_BUCKET="franch-attachments"
S3_FORCE_PATH_STYLE="true"

# Azure Blob Storage (used only when STORAGE_PROVIDER="azure")
# Provide either a connection string or the account/key pair.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
AZURE_STORAGE_CONTAINER="attachments"

# Corefactors Teleduce CRM
# Leave the API key blank for deterministic mock mode. Set both values for live reads.
TELEDUCE_API_BASE_URL="https://teleduce.corefactors.in"
TELEDUCE_API_KEY=""
TELEDUCE_CITY_FILTER="Hyderabad,Chennai"
# Production refuses mock mode unless this is explicitly true.
TELEDUCE_ALLOW_MOCK=""
# Shared secret for the real-time lead webhook. Blank means POST requests are rejected.
TELEDUCE_WEBHOOK_SECRET=""

# Protects scheduled worker endpoints. Minimum 32 characters.
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional matching map. Restrict the key by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_STATIC_MAPS_KEY=""

# WhatsApp Business Cloud API. Live sending requires all four credentials.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# Local/demo seed controls. Set a private value before running the seed in production.
SEED_DEFAULT_PASSWORD="LocalDemoOnly!2026"
SEED_MOCK_INVENTORY="true"
